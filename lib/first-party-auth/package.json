{
  "name": "@workspace/first-party-auth",
  "version": "0.1.0",
  "description": "ClaimTagX-owned first-party authentication core (vendored from Plug&Play auth-core, then adapted).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"./test-dist/**/*.test.js\"",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.20.0"
  }
}
