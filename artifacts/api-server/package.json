{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:worker": "node --enable-source-maps ./dist/worker.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p ../../lib/db/tsconfig.json && tsc -p tsconfig.json --noEmit",
    "gate:identity-provider": "node ../../scripts/no-hosted-idp-gate.mjs",
    "test": "node ../../scripts/no-hosted-idp-gate.mjs && tsx --test src/lib/crm/*.test.ts src/lib/auth/*.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/first-party-auth": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10",
    "libphonenumber-js": "^1.12.15",
    "sanitize-html": "^2.17.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
